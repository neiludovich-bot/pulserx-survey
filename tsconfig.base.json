{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@interview/engine": ["packages/engine/src/index.ts"],
      "@interview/evals": ["packages/evals/src/index.ts"],
      "@interview/prompts": ["packages/prompts/src/index.ts"],
      "@interview/schemas": ["packages/schemas/src/index.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
