{
  "name": "@interview/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --target es2022 --out-dir dist --clean --external openai --external @interview/prompts --external @interview/schemas",
    "lint": "eslint .",
    "replay:openai": "tsx src/replay-openai.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@interview/prompts": "0.1.0",
    "@interview/schemas": "0.1.0",
    "openai": "^4.0.0"
  }
}
