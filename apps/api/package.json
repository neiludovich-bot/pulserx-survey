{
  "name": "@interview/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node20 --out-dir dist --clean",
    "start": "dotenv -e ../../.env -- node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@interview/engine": "0.1.0",
    "@interview/prompts": "0.1.0",
    "@interview/schemas": "0.1.0",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.11.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
